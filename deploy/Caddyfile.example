# contoh setelan Caddy buat VM demo publik (Caddy dipasang manual, file ini ga otomatis disalin deploy_gce.sh)
# salin ke /etc/caddy/Caddyfile, sesuain domainnya (sslip.io buat cadangan ngikutin IP VM), trus: sudo systemctl reload caddy
halio.ardelyo.com, 34-101-109-211.sslip.io {
	encode gzip
	# samain batasnya dgn HALIO_MAX_BODY_MB biar upload kegedean langsung mental di depan sebelom nyentuh API
	request_body {
		max_size 16MB
	}
	reverse_proxy 127.0.0.1:8000
}
