# profil luring (T1): semua yg butuh internet/AI dimatiin, data ga ada yg keluar dr server
# pake: cp .env.offline.example .env.offline lalu docker compose -f docker-compose.offline.yml up -d
PUBLIC_BASE_URL=http://localhost:8000
HALIO_DB=/data/halio.db
HALIO_RATE_LIMIT=60

# tanpa AI, tanpa web, tanpa media
HALIO_LLM=0
HALIO_MEDIA=0
HALIO_LINK_CHECK=0
HALIO_SENSOR=0
# jgn isi GOOGLE_FACTCHECK_API_KEY / ANTHROPIC_API_KEY di profil ini

# radar tetep tertutup kecuali diakses dr mesin sendiri
HALIO_K_ANON=5
HALIO_RETENTION_DAYS=30
