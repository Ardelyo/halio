# Public URL of this deployment (used for WhatsApp media links)
PUBLIC_BASE_URL=http://localhost:8000
HALIO_DB=/data/halio.db
# Comma-separated trusted extension/web origins. Empty means same-origin only.
HALIO_CORS_ORIGINS=
# Requests per minute per client on /api and /webhook
HALIO_RATE_LIMIT=60
# Comma-separated trusted extension/web origins. Empty means same-origin only.
HALIO_CORS_ORIGINS=
HALIO_RATE_LIMIT=60

# Retrieval thresholds (re-run eval/run_eval.py after changing)
HALIO_MATCH_THRESHOLD=0.40
HALIO_UNSURE_THRESHOLD=0.26

# Radar privacy
HALIO_K_ANON=5
# Days kept for unknown claims, appeals, closed tickets, review audit and Telusur investigations (pending tickets stay)
HALIO_RETENTION_DAYS=30
# Set to require "Authorization: Bearer <token>" on /api/radar
RADAR_TOKEN=

# Optional T1: Google Fact Check Tools API key
GOOGLE_FACTCHECK_API_KEY=

# Optional T2: Gemini web investigation on Vertex AI (pip install google-genai; auth via
# Application Default Credentials: `gcloud auth application-default login` or a service account).
# The backend fetches every URL Gemini returns and checks each quote against the page itself.
HALIO_LLM=0
HALIO_LLM_PROVIDER=google
# Evidence engine: v2 = passages picked by code, model only judges numbered quotes (docs/PLAN_VERIFIKASI_AI.md); v1 = earlier agent
HALIO_ENGINE=v2
HALIO_LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_CLOUD_PROJECT=gemma4good-494311
# Gemini 3.5 Flash-Lite is served from "global" (or the us/eu multi-regions), not us-central1.
GOOGLE_CLOUD_LOCATION=global
HALIO_AGENT_TIMEOUT=45
# Legacy provider: HALIO_LLM_PROVIDER=anthropic, HALIO_LLM_MODEL=claude-haiku-5-5, ANTHROPIC_API_KEY set.
ANTHROPIC_API_KEY=

# Sensor (docs/ARCHITECTURE_SENSOR.md): polls public news/fact-check feeds. Off by default.
HALIO_SENSOR=0
HALIO_SENSOR_WORKERS=8
HALIO_SENSOR_TICK=15
# Identify yourself to the sites you poll; put a contact in it for production.
HALIO_SENSOR_UA="HalioSensor/0.1 (riset anti-disinformasi; hanya feed publik)"

# Channels
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Abuse limits and trust (backend/halio/netguard.py)
HALIO_MAX_INPUT=4000
# Set to 1 only behind a reverse proxy that appends X-Forwarded-For
HALIO_TRUST_PROXY=0
# Same value on the API and on our bots; lets the bots name the reporter
HALIO_CHANNEL_KEY=
# Radar answers only localhost unless RADAR_TOKEN is set or this is 1 (public demo)
HALIO_RADAR_PUBLIC=0
# Required to accept WhatsApp webhooks (X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# Photos / voice notes read by Gemini (independent of HALIO_LLM) and link checking
HALIO_MEDIA=0
HALIO_MEDIA_MODEL=gemini-3.5-flash-lite
HALIO_LINK_CHECK=1

# Halio Telusur (investigation swarm) and the daily analyst brief
HALIO_AGENT_DAILY_CAP=60
HALIO_AGENT_PER_REPORTER=8
HALIO_BRIEF=0

# Archive of fact-check headlines: python scripts/crawl_arsip.py (data/arsip.jsonl, not committed)
