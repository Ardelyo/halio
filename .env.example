# url publik server ini, kepake buat link media whatsapp
PUBLIC_BASE_URL=http://localhost:8000
HALIO_DB=/data/halio.db
# daftar origin web/ekstensi yg dipercaya (pisahin pake koma, kosongin kl same-origin aja)
HALIO_CORS_ORIGINS=
# batas request per menit tiap klien di /api sm /webhook
HALIO_RATE_LIMIT=60
# kosongin aja kalo blm pake domain terpisah buat ekstensi
HALIO_CORS_ORIGINS=
HALIO_RATE_LIMIT=60

# batas skor pencocokan korpus (kalo diubah wajib jalanin ulang eval/run_eval.py dulu)
HALIO_MATCH_THRESHOLD=0.40
HALIO_UNSURE_THRESHOLD=0.26

# setelan privasi radar
HALIO_K_ANON=5
# berapa hari nyimpen klaim blm dikenal, sanggahan, tiket tutup, audit & telusur (tiket antre tetep aman)
HALIO_RETENTION_DAYS=30
# isi token ini biar endpoint /api/radar wajib pake header Authorization: Bearer
RADAR_TOKEN=

# opsional lapis 1: api key Google Fact Check Tools
GOOGLE_FACTCHECK_API_KEY=

# opsional lapis 2: cek web pake Gemini di Vertex AI (install google-genai, login pake ADC / service account)
# backend tetep buka tiap url dari Gemini sendiri buat mastiin kutipannya beneran ada di halaman itu
HALIO_LLM=0
HALIO_LLM_PROVIDER=google
# mesin bukti: v2 = kode yg milih kutipan bernomor trus model tinggal nilai, v1 = versi agen lama
HALIO_ENGINE=v2
HALIO_LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_CLOUD_PROJECT=gemma4good-494311
# gemini 3.5 flash-lite adanya di region global (ato multi-region us/eu), jgn taruh us-central1
GOOGLE_CLOUD_LOCATION=global
HALIO_AGENT_TIMEOUT=45
# cadangan provider lama kl mau pake claude (isi HALIO_LLM_PROVIDER=anthropic & api key di bawah)
ANTHROPIC_API_KEY=

# sensor pemantau feed berita & cek fakta publik, bawaan mati dulu
HALIO_SENSOR=0
HALIO_SENSOR_WORKERS=8
HALIO_SENSOR_TICK=15
# identitas user-agent pas polling situs orang, pastin ada kontak kl udah naik produksi
HALIO_SENSOR_UA="HalioSensor/0.1 (riset anti-disinformasi; hanya feed publik)"

# token kanal bot telegram & whatsapp
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# batas ukuran teks & pengaman jaringan (cek backend/halio/netguard.py)
HALIO_MAX_INPUT=4000
# nyalain ke 1 cuma kl di belakang reverse proxy yg ngirim X-Forwarded-For
HALIO_TRUST_PROXY=0
# kunci rahasia bareng antara API sm bot biar bot bisa ngirim id pelapor
HALIO_CHANNEL_KEY=
# radar cuma bisa dibuka dr localhost kecuali RADAR_TOKEN diisi ato ini diset 1 buat demo publik
HALIO_RADAR_PUBLIC=0
# wajib diisi kl mau nerima webhook whatsapp (buat cek signature X-Hub-Signature-256)
WHATSAPP_APP_SECRET=

# baca foto / voice note lewat Gemini (terpisah dr HALIO_LLM) plus pengecekkan link
HALIO_MEDIA=0
HALIO_MEDIA_MODEL=gemini-3.5-flash-lite
HALIO_LINK_CHECK=1

# kuota Halio Telusur & ringkasan harian analis
# pas masa penjurian 16-24 Nov naikin ke ~200 biar juri ga kena tolak, tp pengaman biaya di bawah tetep nyalain
HALIO_AGENT_DAILY_CAP=60
HALIO_AGENT_PER_REPORTER=8
# batas harian biar tagihan gcp ga jebol pas penjurian wkwk (0 = tanpa batas)
# lewat HALIO_LLM_DAILY_CAP bakal jawab dr korpus lokal aja ("mode tanpa AI"), lewat media cap dapet 429
# saran buat demo publik: llm=1500, media=300 (sesuain sm budget billing)
HALIO_LLM_DAILY_CAP=0
HALIO_MEDIA_DAILY_CAP=0
# tolak request kegedean pake 413 (samain juga sm max_size request_body di Caddyfile)
HALIO_MAX_BODY_MB=16
# header Content-Security-Policy di tiap respons: enforce (bawaan), report, ato off
HALIO_CSP=enforce
HALIO_BRIEF=0

# arsip judul cek fakta dr scripts/crawl_arsip.py (disimpen di data/arsip.jsonl, ga ikut ke-commit)
