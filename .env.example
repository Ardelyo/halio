# Public URL of this deployment (used for WhatsApp media links)
PUBLIC_BASE_URL=http://localhost:8000
HALIO_DB=/data/halio.db

# Retrieval thresholds (re-run eval/run_eval.py after changing)
HALIO_MATCH_THRESHOLD=0.40
HALIO_UNSURE_THRESHOLD=0.26

# Radar privacy
HALIO_K_ANON=5
# Set to require "Authorization: Bearer <token>" on /api/radar
RADAR_TOKEN=

# Optional T1: Google Fact Check Tools API key
GOOGLE_FACTCHECK_API_KEY=

# Optional T2: grounded LLM (needs ANTHROPIC_API_KEY and `pip install anthropic`)
HALIO_LLM=0
HALIO_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Channels
TELEGRAM_BOT_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
